{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha.local/schemas/alpha.dir/1",
  "title": "alpha.dir/1",
  "description": "Directory node in the Drive tree. Children map names → content-addressed ciphertext block hashes. Open-ended toward per-entry wrapped keys (cryptree).",
  "type": "object",
  "required": ["schema", "children"],
  "properties": {
    "schema": { "const": "alpha.dir/1" },
    "children": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["hash", "kind"],
        "properties": {
          "hash": {
            "type": "string",
            "description": "SHA-256 hex of ciphertext block bytes"
          },
          "kind": {
            "type": "string",
            "enum": [
              "dir",
              "file",
              "project",
              "task",
              "note",
              "track",
              "playlist",
              "media",
              "blob",
              "account",
              "ledger",
              "invoice",
              "activity",
              "cost_item",
              "sales_line",
              "enterprise",
              "chat_message",
              "chat_feed"
            ]
          },
          "wrapped_key": {
            "type": ["string", "null"],
            "description": "Optional: child key wrapped to parent/root cap (cryptree). Null in v0 when HKDF(root, path) is used."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
