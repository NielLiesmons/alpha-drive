{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha.local/schemas/alpha.chat_message/1",
  "title": "alpha.chat_message/1",
  "description": "Private chat / comment leaf. Drive is SoT.",
  "type": "object",
  "required": ["schema", "id", "kind", "author", "body", "created_at"],
  "properties": {
    "schema": { "const": "alpha.chat_message/1" },
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["comment", "reaction", "chat", "event"],
      "description": "event = entity created/shared tip; ref required; body usually empty"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Mailbox email of the member"
    },
    "body": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "ref": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["task", "note", "project", "enterprise", "mail", "chat", "sheet", "table", "ai_thread", "git_repo", "file"]
        },
        "id": { "type": "string", "minLength": 1 },
        "action": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "from": { "type": "string" },
        "from_name": { "type": "string" },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based index of this comment on the entity thread. Instantly tells the feed if earlier comments exist (seq > 0)."
        }
      },
      "additionalProperties": false
    },
    "reaction": {
      "type": "string",
      "description": "When kind=reaction: emoji or short code"
    },
    "reply_to": {
      "type": ["string", "null"],
      "description": "Parent chat_message id when this is a reply"
    },
    "channel_id": {
      "type": "string",
      "description": "Owning chat (default general)"
    },
    "delivery": {
      "type": "string",
      "enum": ["sending", "sent", "delivered", "read"],
      "description": "sent = on Drive; read = at least one other account opened it"
    },
    "read_by": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Emails that marked this message read"
    },
    "attachments": {
      "type": "array",
      "description": "Media / files on Drive (chat/media/… or media_blob manifest)",
      "items": {
        "type": "object",
        "required": ["path", "content_type", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content_type": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["image", "video", "file", "voice"]
          },
          "name": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "duration_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
