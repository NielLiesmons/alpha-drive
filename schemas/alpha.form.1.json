{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha.local/schemas/alpha.form/1",
  "title": "alpha.form/1",
  "description": "Phone/desktop capture profile: appends alpha.table_row/1 to a table. One generic runner for every enterprise.",
  "type": "object",
  "required": ["schema", "id", "title", "table_id", "fields", "created_at"],
  "properties": {
    "schema": { "const": "alpha.form/1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "table_id": { "type": "string", "minLength": 1 },
    "enterprise_id": { "type": ["string", "null"] },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["column_key"],
        "properties": {
          "column_key": {
            "type": "string",
            "minLength": 1,
            "description": "Matches alpha.table column.key"
          },
          "required": { "type": "boolean", "default": true },
          "default": {
            "description": "Optional default; 'today' for date columns means YYYY-MM-DD now"
          }
        },
        "additionalProperties": false
      }
    },
    "occurred_on_field": {
      "type": "boolean",
      "default": true,
      "description": "When true, stamp row.occurred_on from a date field or today"
    },
    "labels": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
