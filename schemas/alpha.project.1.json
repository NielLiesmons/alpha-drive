{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha.local/schemas/alpha.project/1",
  "title": "alpha.project/1",
  "description": "Project entity — not a folder. Links to Drive path prefixes and optional mail/site.",
  "type": "object",
  "required": ["schema", "id", "slug", "title", "created_at"],
  "properties": {
    "schema": { "const": "alpha.project/1" },
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": {
      "type": "string",
      "description": "Single long-form project description (no separate body field)."
    },
    "status": {
      "type": "string",
      "enum": ["backlog", "planned", "inProgress", "closed", "canceled"],
      "description": "Optional persisted hint; Admin derives display status from linked tasks."
    },
    "icon": {
      "type": "string",
      "description": "Emoji character(s), or later a custom/image emoji reference (data URL / https URL)."
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
          "sort": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "drive": {
      "type": "object",
      "description": "Path prefixes inside the Space Drive this Project uses",
      "properties": {
        "private_prefix": { "type": "string" },
        "public_prefix": { "type": "string" },
        "home_prefix": { "type": "string" }
      }
    },
    "mail_list_id": { "type": ["string", "null"] },
    "site_url": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
