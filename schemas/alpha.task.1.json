{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha.local/schemas/alpha.task/1",
  "title": "alpha.task/1",
  "description": "Task content object linked to a Project id (entity link, not filesystem parenthood alone).",
  "type": "object",
  "required": ["schema", "id", "project_id", "title", "status", "created_at"],
  "properties": {
    "schema": { "const": "alpha.task/1" },
    "id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["todo", "doing", "done", "cancelled"]
    },
    "milestone_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "due_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
