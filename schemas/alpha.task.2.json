{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha.local/schemas/alpha.task/2",
  "title": "alpha.task/2",
  "description": "Task content object. Links zero or more Projects via project_ids (labels), not filesystem parenthood.",
  "type": "object",
  "required": ["schema", "id", "project_ids", "title", "status", "created_at"],
  "properties": {
    "schema": { "const": "alpha.task/2" },
    "id": { "type": "string", "minLength": 1 },
    "project_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "description": "Deprecated singular from alpha.task/1 — clients should prefer project_ids"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["backlog", "open", "inProgress", "inReview", "closed", "canceled"]
    },
    "priority": {
      "type": "string",
      "enum": ["none", "low", "medium", "high", "urgent"]
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "milestone_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "due_at": { "type": ["string", "null"], "format": "date-time" },
    "start_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Planning / Gantt bar start"
    },
    "end_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Planning / Gantt bar end"
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Other task ids this task depends on"
    }
  },
  "additionalProperties": false
}
